{
  "dist": {
    "requiredFiles": [
      "index.html",
      "sitemap.xml",
      "robots.txt",
      "404.html",
      ".htaccess"
    ],
    "forbiddenPaths": [
      "server"
    ],
    "forbiddenPublicText": [
      "localhost"
    ]
  },
  "sitemap": {
    "requireLocTargetsToExistInDist": true,
    "requireHtmlFilesToBeListed": true,
    "requireCanonicalHost": "https://bezotcorp.com",
    "excludeFiles": [
      "404.html"
    ]
  },
  "seo": {
    "requireTitle": true,
    "requireMetaDescription": true,
    "requireCanonical": true,
    "requireCanonicalMatchesRoute": true,
    "requireHtmlLang": false,
    "requireSingleH1": false,
    "forbidNoindexOnPublishedPages": false,
    "excludeFiles": [
      "404.html"
    ]
  },
  "html": {
    "requireHtmlLang": true,
    "requireSingleH1": true,
    "requireImageAlt": true,
    "forbidEmptyAriaLabel": true,
    "forbidFocusableAriaHidden": true,
    "requireInternalLinksToExist": true,
    "excludeFiles": [
      "404.html"
    ]
  }
}
